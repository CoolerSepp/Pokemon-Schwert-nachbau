{
  "name": "aetheria-monster-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Ein eigenstaendiges 3D-Monster-RPG im Browser (Three.js + TypeScript).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run build && npm run build:offline && npm run test:e2e",
    "build:offline": "tsc --noEmit && node tools/build_offline.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
